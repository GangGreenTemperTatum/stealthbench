# StealthBench environment variables
# Copy to .env and fill in your values: cp .env.example .env

# REQUIRED: OpenRouter API key (routes agent + judge model calls)
OPENROUTER_API_KEY=

# OPTIONAL: Logfire write token (telemetry — benchmark runs fine without it)
LOGFIRE_TOKEN=

# OPTIONAL: Logfire read token (for exporting OTEL spans)
LOGFIRE_READ_TOKEN=

# OPTIONAL: OpenAI API key (only needed for direct openai/ model slugs)
OPENAI_API_KEY=

# OPTIONAL: Windows endpoint suite (deploy infra/aws/windows-endpoint.yaml first)
# AWS credentials stay on the controller; never mount this file into the agent.
AWS_PROFILE=
AWS_REGION=us-west-2
STEALTHBENCH_WINDOWS_INSTANCE_ID=
# Four distinct instances are required only for the multi-worker launcher.
STEALTHBENCH_WINDOWS_INSTANCE_IDS=
